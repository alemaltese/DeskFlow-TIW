<nav class="navbar">
  <div class="container">
    {{#if isAdmin}}
      <a href="/admin/dashboard" class="nav-brand">Helpdesk</a>
    {{else if isOperatore}}
      <a href="/operatore/dashboard" class="nav-brand">Helpdesk</a>
    {{else if currentUser}}
      <a href="/tickets" class="nav-brand">Helpdesk</a>
    {{else}}
      <a href="/" class="nav-brand">Helpdesk</a>
    {{/if}}
    <div class="nav-links">
      {{#if currentUser}}
        {{#if isAdmin}}
          <a href="/admin/dashboard">Dashboard</a>
          <a href="/admin/tickets">Ticket</a>
          <span class="nav-username">{{currentUser.name}}</span>
        {{else}}
          {{#if isOperatore}}
            <a href="/operatore/dashboard">Dashboard</a>
            <a href="/operatore/tickets">Ticket</a>
            <span class="nav-username">{{currentUser.name}}</span>
          {{else}}
            <a href="/tickets">I miei ticket</a>
            <span class="nav-username">{{currentUser.name}}</span>
          {{/if}}
        {{/if}}
        <a href="/logout">Esci</a>
      {{else}}
        <a href="/login">Accedi</a>
        <a href="/register">Registrati</a>
      {{/if}}
    </div>
  </div>
</nav>
